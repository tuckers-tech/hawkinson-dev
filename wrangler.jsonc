{
    "main": "dist/_worker.js/index.js",
    "name": "hawkinson-dev",
    "compatibility_date": "2026-04-25",
    "compatibility_flags": [
      "nodejs_compat",
      "global_fetch_strictly_public"
    ],
    "assets": {
        "binding": "ASSETS",
        "directory": "./dist"
    },
    "observability": {
    "enabled": true
    }
}