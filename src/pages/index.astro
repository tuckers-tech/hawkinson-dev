---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import ContactLinks from "../components/ContactLinks.astro";

const BLOG_URL = "https://tuckers-tech.com";

const experience = [
  {
    period: "2026 — Present",
    role: "Founder and CEO",
    company: "Stealth Startup",
  },
  {
    period: "2023 — Present",
    role: "Founding Engineer (Senior → Staff)",
    company: "Owner.com",
  },
  {
    period: "2020 — 2023",
    role: "Application Developer → Senior Application Developer",
    company: "Spathe Systems",
  },
  {
    period: "Jan 2017 — May 2017",
    role: "Production Intern",
    company: "SpaceX",
  },
  {
    period: "2015 — 2020",
    role: "Intern → Engineer",
    company: "United States Federal Government",
  },
];

const contactLinks = [
  { label: "Email", href: "mailto:public@hawkinson.dev" },
  { label: "GitHub", href: "https://github.com/tuckers-tech" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/tuckers-tech/" },
  { label: "Blog", href: BLOG_URL },
];
---

<BaseLayout title="Tucker Hawkinson">
  <Hero blogUrl={BLOG_URL} />

  <section id="experience" class="max-w-5xl mx-auto px-6 md:px-8 py-16 md:py-24">
    <SectionHeading label="Career" title="Experience" />
    <div class="border-t border-border">
      {experience.map((item) => <ExperienceItem {...item} />)}
    </div>
  </section>

  <section id="writing" class="max-w-5xl mx-auto px-6 md:px-8 py-16 md:py-24">
    <SectionHeading label="Writing" title="On the blog" />
    <p class="text-text-muted text-lg max-w-2xl leading-relaxed">
      Long-form notes on engineering, leadership, and the craft of shipping
      software live on <span class="font-mono text-text">tuckers-tech</span>.
      Essays, deep-dives, and the occasional opinion.
    </p>
    <div class="mt-8">
      <a
        href={BLOG_URL}
        class="inline-flex items-center gap-2 border border-accent bg-accent/5 rounded-full px-6 py-2.5 text-accent hover:bg-accent/10 transition-colors"
      >
        Read tuckers-tech
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <section id="contact" class="max-w-5xl mx-auto px-6 md:px-8 pt-16 md:pt-24 pb-8 md:pb-12">
    <SectionHeading label="Get in touch" title="Contact" />
    <p class="text-text-muted text-lg max-w-2xl leading-relaxed mb-8">
      The fastest way to reach me is email. I read everything; I reply to most.
    </p>
    <ContactLinks links={contactLinks} />
  </section>
</BaseLayout>
