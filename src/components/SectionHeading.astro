---
import AccentSquare from "./AccentSquare.astro";

interface Props {
  label: string;
  title: string;
  id?: string;
}

const { label, title, id } = Astro.props;
---

<header class="mb-12" id={id}>
  <div class="flex items-center gap-3 mb-4">
    <AccentSquare size="md" />
    <span class="text-sm text-text-muted uppercase tracking-widest">{label}</span>
  </div>
  <h2 class="text-3xl md:text-4xl font-semibold leading-tight">{title}</h2>
</header>
