---
import AccentSquare from "./AccentSquare.astro";

interface Props {
  blogUrl: string;
}

const { blogUrl } = Astro.props;
---

<section class="max-w-5xl mx-auto px-6 md:px-8 py-24 md:py-40">
  <div class="flex items-center gap-3 mb-8">
    <AccentSquare size="md" />
    <span class="text-sm text-text-muted uppercase tracking-widest">
      Engineer · Builder · Writer
    </span>
  </div>

  <h1 class="text-5xl md:text-7xl lg:text-8xl font-semibold leading-tight max-w-4xl">
    Tucker Hawkinson
  </h1>

  <p class="text-text-muted text-lg md:text-xl mt-8 max-w-2xl leading-relaxed">
    I build software, lead teams, and write about engineering and the craft of
    shipping in the AI age. This is my landing pad — the long-form lives on the
    blog.
  </p>

  <div class="mt-12 flex flex-wrap gap-3">
    <a
      href={blogUrl}
      class="inline-flex items-center gap-2 border border-accent bg-accent/5 rounded-full px-6 py-2.5 text-accent hover:bg-accent/10 transition-colors"
    >
      Read the blog
      <span aria-hidden="true">&rarr;</span>
    </a>
    <a
      href="#contact"
      class="inline-flex items-center gap-2 border border-border rounded-full px-6 py-2.5 text-text-muted hover:text-accent hover:border-accent transition-colors"
    >
      Get in touch
    </a>
  </div>
</section>
