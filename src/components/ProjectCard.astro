---
import AccentSquare from "./AccentSquare.astro";

interface Props {
  title: string;
  description: string;
  tags?: string[];
  href?: string;
}

const { title, description, tags = [], href } = Astro.props;

const Wrapper = href ? "a" : "div";
const wrapperProps = href
  ? { href, class: "group block py-8 border-b border-border" }
  : { class: "block py-8 border-b border-border" };
---

<Wrapper {...wrapperProps}>
  <div class="flex items-start gap-4">
    <div class="pt-2">
      <AccentSquare />
    </div>
    <div class="flex-1">
      <h3
        class={`text-2xl md:text-3xl font-semibold ${href ? "group-hover:text-accent transition-colors" : ""}`}
      >
        {title}
      </h3>
      <p class="text-text-muted mt-2 leading-relaxed">{description}</p>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map((tag) => (
            <span class="inline-flex items-center gap-1.5 border border-border text-text-muted rounded-full font-mono text-xs px-2.5 py-0.5">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>
</Wrapper>
