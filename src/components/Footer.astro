---
import AccentSquare from "./AccentSquare.astro";
---

<footer class="max-w-5xl mx-auto px-6 md:px-8 py-12 border-t border-border">
  <div class="flex items-center justify-between text-sm text-text-muted">
    <div class="flex items-center gap-2">
      <AccentSquare />
      <span>&copy; {new Date().getFullYear()} Tucker Hawkinson</span>
    </div>
    <a
      href="https://tuckers.tech"
      class="hover:text-accent transition-colors"
    >
      tuckers.tech &rarr;
    </a>
  </div>
</footer>
